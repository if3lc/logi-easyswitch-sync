         self._write(event.hid_message)
 
+    def _defer_write(self, msg: bytes) -> None:
+        """Park a write for a device that is between connections and poke the reconnect loop.
+
+        Runs on the write topic's drain thread, so it must not block: the reader thread flushes
+        the parked messages from _try_connect once the collection is open again.
+        """
+        with self._deferred_lock:
+            self._deferred = (time.monotonic() + _DEFERRED_WRITE_TTL, msg)
+        log.info(
+            f"pid=0x{self._device_info.pid:04X} not connected yet — holding write for up to "
+            f"{_DEFERRED_WRITE_TTL:.0f}s until it reconnects"
+        )
+        self._wake.set()
+
+    def _flush_deferred(self) -> None:
+        with self._deferred_lock:
+            pending, self._deferred = self._deferred, None
+        if pending is None:
+            return
+        expires_at, msg = pending
+        if expires_at < time.monotonic():
+            log.debug(f"Discarding expired deferred write to pid=0x{self._device_info.pid:04X}: {msg.hex()}")
+            return
+        log.info(f"pid=0x{self._device_info.pid:04X} reconnected — sending held write")
+        self._write(msg)
+
     def _write(self, msg: bytes) -> None:
         # Snapshot the transport: _try_connect can null it between this check and the write,
         # and the resulting AttributeError is not a TransportError, so it would kill this thread.
