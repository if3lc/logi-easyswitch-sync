 # Reconnect backoff. A device parked on another host used to make every disconnected gateway
 # re-enumerate once per second forever (issue #108 logged ~894 sweeps over 94 minutes).
+#
+# The cap is deliberately short. After an Easy-Switch round trip the device is back on this host
+# within a couple of seconds, and until the gateway has re-opened the collection every write to it
+# — including the CHANGE_HOST relay for the mouse — is dropped. With a 30 s cap a press that landed
+# shortly after the devices came back relayed only the keyboard (issue #121: "slow to re-arm").
+# The discovery loop already calls hid_enumerate twice a second, so a 2 s cap adds no real load.
 _RECONNECT_BACKOFF_MIN = 1.0
-_RECONNECT_BACKOFF_MAX = 30.0
+_RECONNECT_BACKOFF_MAX = 2.0
+
+# A write that arrives while the gateway is between connections is parked instead of dropped, and
+# flushed by the reader thread right after the next successful (re)connect. Only the most recent
+# write is kept: in practice the only traffic to a disconnected device is the CHANGE_HOST relay, and
+# the user's last press is their intent — replaying an older one would bounce the mouse away again.
+# A parked write older than the TTL is discarded at flush time so a stale CHANGE_HOST never fires on
+# a connect that happens much later. The TTL covers HID re-open plus the BLE notify subscription
+# (_BLE_SUBSCRIBE_GRACE in hid_gateway_ble.py) that the reconnect waits for before flushing.
+_DEFERRED_WRITE_TTL = 5.0
 
 # How long close() waits for the reader thread to tear down its own handle. Must comfortably
 # exceed HIDTransport._READ_POLL_MS.
@@ -44,9 +59,14 @@ class HidGateway(Thread, Subscriber):
         self._ever_connected: bool = False
         self._grace_deadline = time.monotonic() + _FIRST_CONNECT_GRACE
         self._stop = threading.Event()
+        # Set to cut a backoff wait short: a parked write wants the reconnect attempt now, not
+        # when the current sleep runs out. close() sets it too so run() exits promptly.
+        self._wake = threading.Event()
         self._transport: HIDTransport | None = None
         self._event_listener: EventListener = event_listener
         self._backoff: float = _RECONNECT_BACKOFF_MIN
+        self._deferred_lock = threading.Lock()
+        self._deferred: tuple[float, bytes] | None = None  # (expires_at, hid_message)
 
     @property
     def _connected(self) -> bool:
@@ -105,12 +125,14 @@ class HidGateway(Thread, Subscriber):
                 self._transport.try_reopen()
             self._set_connected(True)
             self._backoff = _RECONNECT_BACKOFF_MIN
+            self._flush_deferred()
         except OSError as e:
             log.debug(f"Failed to connect to HID device pid=0x{self._device_info.pid:04X}: {e}")
             self._backoff_wait()
 
     def _backoff_wait(self) -> None:
-        self._stop.wait(self._backoff)
+        self._wake.wait(self._backoff)
+        self._wake.clear()
         self._backoff = min(self._backoff * 2, _RECONNECT_BACKOFF_MAX)
 
     def _close_transport(self) -> None:
@@ -130,19 +152,48 @@ class HidGateway(Thread, Subscriber):
         if event.pid != self._device_info.pid:
             return
 
-        if not self._connected:
-            grace = max(0.0, self._grace_deadline - time.monotonic())
-            if self._ever_connected or not self._connected_signal.wait(grace):
-                log.debug(f"Dropping write to pid=0x{self._device_info.pid:04X}: device disconnected")
-                return
-
         if _IS_WINDOWS:
             expected = _USAGE_TO_REPORT_ID.get(self._device_info.usage)
             if expected is None or event.hid_message[0] != expected:
                 return
 
+        if not self._connected:
+            if self._ever_connected:
+                self._defer_write(event.hid_message)
+                return
+            grace = max(0.0, self._grace_deadline - time.monotonic())
+            if not self._connected_signal.wait(grace):
+                log.debug(f"Dropping write to pid=0x{self._device_info.pid:04X}: device disconnected")
+                return
