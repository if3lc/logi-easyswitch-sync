+# ── Deferred writes across a reconnect (issue #121) ─────────────────────────
+
+
+def test_backoff_cap_covers_an_easy_switch_round_trip():
+    """A device that left for another host is back within a couple of seconds; the gateway must
+    notice before the user presses Easy-Switch again, or the mouse relay is dropped."""
+    assert _RECONNECT_BACKOFF_MAX <= 2.0
+
+
+def test_notify_defers_write_when_disconnected_and_was_previously_connected():
+    gw = HidGateway(_device_info(), MagicMock(spec=EventListener))
+    gw._connected = False
+    gw._ever_connected = True
+    gw._transport = MagicMock()
+    msg = bytes([REPORT_LONG]) + bytes(19)
+
+    gw.notify(WriteEvent(slot=1, pid=BOLT_PID, hid_message=msg))
+
+    gw._transport.write.assert_not_called()
+    assert gw._deferred[1] == msg
+    assert gw._wake.is_set(), "a parked write must cut the reconnect backoff short"
+
+
+def test_notify_does_not_block_drain_thread_when_deferring():
+    gw = HidGateway(_device_info(), MagicMock(spec=EventListener))
+    gw._connected = False
+    gw._ever_connected = True
+    gw._transport = MagicMock()
+
+    started = time.monotonic()
+    gw.notify(WriteEvent(slot=1, pid=BOLT_PID, hid_message=b"\x11" + bytes(19)))
+
+    assert time.monotonic() - started < 0.5
+
+
+def test_try_connect_flushes_deferred_writes_after_reconnect(mocker):
+    info = _device_info()
+    gw = HidGateway(info, MagicMock(spec=EventListener))
+    gw._ever_connected = True
+    transport = MagicMock()
+    gw._transport = transport
+    mocker.patch("cleverswitch.gateway.hid_gateway.enumerate_hid_devices", return_value={info.pid: [info]})
+    msg = bytes([REPORT_LONG]) + bytes(19)
+    gw.notify(WriteEvent(slot=1, pid=BOLT_PID, hid_message=msg))
+    transport.write.assert_not_called()
+
+    gw._try_connect()
+
+    transport.try_reopen.assert_called_once()
+    transport.write.assert_called_once_with(msg)
+    assert gw._deferred is None
+
+
+def test_flush_discards_expired_deferred_writes(mocker):
+    info = _device_info()
+    gw = HidGateway(info, MagicMock(spec=EventListener))
+    gw._ever_connected = True
+    transport = MagicMock()
+    gw._transport = transport
+    mocker.patch("cleverswitch.gateway.hid_gateway.enumerate_hid_devices", return_value={info.pid: [info]})
+    gw._deferred = (time.monotonic() - 0.1, b"\x11" + bytes(19))
+
+    gw._try_connect()
+
+    transport.write.assert_not_called()
+    assert gw._deferred is None
+
+
+def test_latest_deferred_write_wins():
+    """Two presses while the mouse is away must not replay both: the last one is the user's intent."""
+    gw = HidGateway(_device_info(), MagicMock(spec=EventListener))
+    gw._connected = False
+    gw._ever_connected = True
+
+    for i in range(3):
+        gw.notify(WriteEvent(slot=1, pid=BOLT_PID, hid_message=bytes([REPORT_LONG, i]) + bytes(18)))
+
+    assert gw._deferred[1][1] == 2
+
+
+def test_flush_with_nothing_deferred_is_a_noop(mocker):
+    info = _device_info()
+    gw = HidGateway(info, MagicMock(spec=EventListener))
+    transport = MagicMock()
+    gw._transport = transport
+    mocker.patch("cleverswitch.gateway.hid_gateway.enumerate_hid_devices", return_value={info.pid: [info]})
+
+    gw._try_connect()
+
+    transport.write.assert_not_called()
+
+
+def test_backoff_wait_is_cut_short_by_wake():
+    gw = HidGateway(_device_info(), MagicMock(spec=EventListener))
+    gw._backoff = 5.0
+    gw._wake.set()
+
+    started = time.monotonic()
+    gw._backoff_wait()
+
+    assert time.monotonic() - started < 1.0
+    assert not gw._wake.is_set()
+
+
+def test_close_wakes_a_gateway_parked_in_backoff(mocker):
+    gw = HidGateway(_device_info(), MagicMock(spec=EventListener))
+    gw._transport = None
+    gw._backoff = 5.0
+    mocker.patch("cleverswitch.gateway.hid_gateway.enumerate_hid_devices", return_value={})
+
+    gw.start()
+    time.sleep(0.05)
+    gw.close()
+
+    assert not gw.is_alive()
